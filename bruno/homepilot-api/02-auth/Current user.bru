meta {
  name: Current user
  type: http
  seq: 2
  tags: [
    read-only
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

docs {
  Requiere un token obtenido manualmente y mantenido fuera de Git.
}

tests {
  test("returns the authenticated user", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.be.a("string");
    expect(res.body.username).to.be.a("string");
    expect(res.body.role).to.be.a("string");
  });
}
