meta {
  name: Login - MUTANTE
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "SET_IN_LOCAL_ENV",
    "password": "SET_IN_LOCAL_ENV"
  }
}

docs {
  No guardar ni ejecutar con credenciales reales. Una respuesta exitosa contiene un token de sesión; no debe persistirse en la colección.
}
