meta {
  name: Execution source history
  type: http
  seq: 145
  tags: [
    read-only
  ]
}

get {
  url: {{baseUrl}}/api/v1/executions/{{executionSource}}/{{executionSourceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
