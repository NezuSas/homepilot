meta {
  name: Sync device state - MUTANTE
  type: http
  seq: 113
}

post {
  url: {{baseUrl}}/api/v1/integrations/state-sync
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {"deviceId":"{{deviceId}}","state":{}}
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
