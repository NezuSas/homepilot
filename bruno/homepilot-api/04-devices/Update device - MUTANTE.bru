patch {
  url: {{baseUrl}}/api/v1/devices/{{deviceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "name": "Test device",
    "invertState": false
  }
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
