meta {
  name: Import HA entity - MUTANTE
  type: http
  seq: 13
  tags: [
    mutant
  ]
}

post {
  url: {{baseUrl}}/api/v1/ha/import
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "entityId": "example.entity_id",
    "name": "Example imported device"
  }
}
