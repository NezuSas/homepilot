meta {
  name: Create automation - MUTANTE
  type: http
  seq: 119
}

post {
  url: {{baseUrl}}/api/v1/automations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "name": "Synthetic automation — DO NOT RUN",
    "trigger": {
      "type": "device_state",
      "deviceId": "{{deviceId}}",
      "state": "on"
    },
    "action": {
      "type": "device_command",
      "deviceId": "{{deviceId}}",
      "command": "turn_off"
    }
  }
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
