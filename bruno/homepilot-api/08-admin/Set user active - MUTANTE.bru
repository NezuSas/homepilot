meta {
  name: Set user active - MUTANTE
  type: http
  seq: 132
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/active
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "active": false
  }
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
