meta {
  name: Speech to text - MUTANTE
  type: http
  seq: 130
}

post {
  url: {{baseUrl}}/api/v1/assistant/stt
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "audioBase64": "",
    "audioContentType": "audio/wav"
  }
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
