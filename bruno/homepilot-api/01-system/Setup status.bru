meta {
  name: Setup status
  type: http
  seq: 2
  tags: [
    read-only
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/system/setup-status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

docs {
  Consulta el estado de configuración inicial. No modifica el sistema.
}

tests {
  test("returns setup status", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("object");
  });
}
