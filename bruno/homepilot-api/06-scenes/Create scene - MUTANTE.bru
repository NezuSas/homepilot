meta {
  name: Create scene - MUTANTE
  type: http
  seq: 122
}

post {
  url: {{baseUrl}}/api/v1/scenes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "name": "Synthetic scene — DO NOT RUN",
    "homeId": "{{homeId}}",
    "roomId": null,
    "actions": [
      { "deviceId": "{{deviceId}}", "command": "turn_off" }
    ],
    "executionMode": "sequential"
  }
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
