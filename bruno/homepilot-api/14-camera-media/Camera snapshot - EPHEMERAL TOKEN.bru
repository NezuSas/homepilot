meta {
  name: Camera snapshot - EPHEMERAL TOKEN
  type: http
  seq: 2
  tags: [
    read-only
    edge
  ]
}

get {
  url: {{baseUrl}}/api/v1/devices/{{deviceId}}/camera/snapshot?token={{cameraProxyToken}}
  body: none
}

docs {
  Use únicamente el token efímero devuelto por "Camera session" en una instalación autorizada. Esta ruta puede acceder a una cámara Edge.
}
