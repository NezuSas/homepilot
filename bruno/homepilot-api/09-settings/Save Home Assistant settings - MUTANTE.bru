meta {
  name: Save Home Assistant settings - MUTANTE
  type: http
  seq: 135
}

post {
  url: {{baseUrl}}/api/v1/settings/home-assistant
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "baseUrl": "http://HOME_ASSISTANT_TEST_HOST:8123",
    "accessToken": "SET_ONLY_IN_LOCAL_ENV"
  }
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
