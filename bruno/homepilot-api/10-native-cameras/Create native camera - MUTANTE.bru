meta {
  name: Create native camera - MUTANTE
  type: http
  seq: 136
  tags: [
    mutant
    edge
  ]
}

post {
  url: {{baseUrl}}/api/v1/native-cameras
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

body:json {
  {
    "homeId": "{{homeId}}",
    "name": "Synthetic camera — DO NOT RUN",
    "host": "192.0.2.10",
    "username": "SET_ONLY_IN_LOCAL_ENV",
    "password": "SET_ONLY_IN_LOCAL_ENV",
    "sourceType": "rtsp-dvr",
    "rtspPath": "/stream"
  }
}

docs {
  Cobertura de ruta con muestra sintética. No ejecutar mutaciones, integraciones Edge o acciones físicas sin autorización explícita.
}
