{
  "name": "homepilot-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix apps/operator-console",
    "dev:api": "ts-node main.ts",
    "dev:ui": "npm run dev --prefix apps/operator-console",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "build": "tsc",
    "check:spec-coverage": "node scripts/check-spec-coverage.mjs",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "check:ui-primitives": "node scripts/check-ui-primitives.mjs",
    "test:responsive": "npm run test:responsive --prefix apps/operator-console",
    "verify:quality": "npm run check:i18n && npm run check:ui-primitives && npm run check:spec-coverage && npm run check:no-production-any && npm run check:architecture-boundaries && npm run check:bdd-traceability && npm run check:module-test-coverage && npm run check:tuya-policy && npm run check:docker-profiles && npm run test:responsive && npm run lint --prefix apps/operator-console && npm run test:coverage && npm run typecheck && npm run build && npm run build --prefix apps/operator-console",
    "start": "node dist/main.js",
    "check:no-production-any": "node scripts/check-no-production-any.mjs",
    "check:architecture-boundaries": "node scripts/check-architecture-boundaries.mjs",
    "check:bdd-traceability": "node scripts/check-bdd-traceability.mjs",
    "check:module-test-coverage": "node scripts/check-module-test-coverage.mjs",
    "check:tuya-policy": "node scripts/check-tuya-policy.mjs",
    "check:docker-profiles": "node scripts/check-docker-profiles.mjs",
    "verify:release": "ts-node scripts/verify_release_v1.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.12",
    "@types/luxon": "^3.7.1",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "bonjour": "^3.5.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.11.3",
    "ioredis": "^5.10.1",
    "luxon": "^3.7.2",
    "multicast-dns": "^7.2.5",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}
